# Environment Configuration for NEMA API

# ========================================
# FEATURE FLAGS - Enable/Disable Features
# ========================================
ENABLE_COMPLIANCE_CHECK=true
ENABLE_DISTANCE_CALCULATION=true
ENABLE_REPORT_GENERATION=true
ENABLE_BATCH_PROCESSING=true
ENABLE_WETLANDS_SEARCH=true
ENABLE_MAP_VISUALIZATION=true

# ========================================
# API SETTINGS
# ========================================
API_TITLE="NEMA Compliance API"
API_VERSION="1.0.0"
API_DESCRIPTION="RESTful API for NEMA environmental compliance checking"

# ========================================
# CORS SETTINGS
# ========================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ========================================
# DATA PATHS
# ========================================
# Path to wetlands shapefile (relative to nema-api directory)
WETLANDS_DATA_PATH=../nema2/data/shapefiles/uganda_wetlands.shp

# Path to report template
REPORT_TEMPLATE_PATH=../nema2/report_template.md.j2

# ========================================
# FILE UPLOAD SETTINGS
# ========================================
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=./uploads

# ========================================
# PROCESSING SETTINGS
# ========================================
DEFAULT_CRS=EPSG:4326  # WGS84
UTM_CRS=EPSG:32636  # UTM Zone 36N for Uganda
MAX_BATCH_SIZE=100

# ========================================
# CACHE SETTINGS
# ========================================
ENABLE_CACHE=true
CACHE_TTL=3600  # 1 hour in seconds

# ========================================
# PRODUCTION SETTINGS (Optional)
# ========================================
# Uncomment for production deployment
# ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com
# API_HOST=0.0.0.0
# API_PORT=8000
# LOG_LEVEL=info
